# Credenciais do Firebase (Console > Configurações do projeto > Seus apps > Web).
# Copie este arquivo para `.env` e preencha. Sem elas o site roda 100% nos
# valores base de lib/config.ts — nada quebra, só não busca preços remotos.
#
# Estas chaves são públicas por natureza (vão no bundle). O que protege os
# dados são as Security Rules do Firestore, não o segredo da chave.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Analytics 4 (opcional). Sem esta linha o site não carrega o SDK de
# analytics nem envia evento nenhum.
VITE_FIREBASE_MEASUREMENT_ID=
